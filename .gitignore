# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments (recreate them with the commands in README.md)
.venv/
venv/

# Editor, notebook and operating-system clutter
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/
anaconda_projects/

# Raw data: downloaded by `make data` from a pinned Hugging Face revision
data/raw/*
!data/raw/README.md

# Model checkpoints (about 10 GB): see artifacts/models/README.md
artifacts/models/*
!artifacts/models/README.md
# Outputs of `make rebuild` and `make smoke`
artifacts/rebuild/
artifacts/smoke/

# Generated by `make reproduce`
results/tables/*
results/figures/*
results/report/*
!results/*/.gitkeep
results/rebuild/
results/smoke/

# Never commit model weights, optimizer state or pickled training arguments
*.safetensors
*.pt
*.pth
*.bin
